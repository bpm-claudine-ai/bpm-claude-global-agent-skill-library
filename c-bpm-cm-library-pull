#!/usr/bin/env bash
#
# c-bpm-cm-library-pull - Pull c-bpm-prefixed items from the Git repository to local ~/.claude/
#
# Usage:
#   c-bpm-cm-library-pull                  Pull all c-bpm-items
#   c-bpm-cm-library-pull --dry-run        Show what would change
#   c-bpm-cm-library-pull --force          Overwrite even on conflicts (repo wins)
#   c-bpm-cm-library-pull --clean            Remove local items that no longer exist in repo
#   c-bpm-cm-library-pull --only-skills    Pull only skills
#   c-bpm-cm-library-pull --push-inventory Push host inventory to remote after commit
#   c-bpm-cm-library-pull --verbose        Show detailed output
#
# Requires: git

set -euo pipefail

VERSION="1.3.0"
REPO_NAME="bpm-claude-global-agent-skill-library"
REPO_URL="git@github.com:BPMspaceUG/bpm-claude-global-agent-skill-library.git"
REPO_DIR="$HOME/$REPO_NAME"

# Source shared library early (provides: ORG_PREFIX, ITEM_PREFIX, SK_PREFIX, CM_PREFIX,
# AG_PREFIX, RB_PREFIX, get_target_dir, log_verbose,
# compute_item_hash, load/save/get/set_sync_hash, prune_sync_state,
# write_host_inventory, SYNC_STATE, etc.)
# Resolve script directory (portable symlink resolution)
_resolve_script_dir() {
  local src="$1"
  while [[ -L "$src" ]]; do
    local dir="$(cd "$(dirname "$src")" && pwd -P)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd "$(dirname "$src")" && pwd -P
}
SCRIPT_DIR="$(_resolve_script_dir "$0")"
source "$SCRIPT_DIR/lib.sh"

# Defaults
DRY_RUN=0
VERBOSE=0
FORCE=0
CLEAN=0
PUSH_INVENTORY=0
ONLY_SKILLS=0
ONLY_AGENTS=0
ONLY_COMMANDS=0
ONLY_RUNBOOKS=0

# Categories to sync
CATEGORIES=(skills agents commands runbooks)

show_help() {
  echo "c-bpm-cm-library-pull v$VERSION - Pull c-bpm-items from repo to local"
  echo ""
  echo "Usage:"
  echo "  c-bpm-cm-library-pull                  Pull all c-bpm-items"
  echo "  c-bpm-cm-library-pull --dry-run        Show what would change without applying"
  echo "  c-bpm-cm-library-pull --force          Overwrite even on conflicts (repo wins)"
  echo "  c-bpm-cm-library-pull --clean          Remove local items not present in repo"
  echo "  c-bpm-cm-library-pull --verbose        Show detailed output"
  echo "  c-bpm-cm-library-pull --push-inventory Push host inventory to remote"
  echo "  c-bpm-cm-library-pull --only-skills    Pull only skills"
  echo "  c-bpm-cm-library-pull --only-agents    Pull only agents"
  echo "  c-bpm-cm-library-pull --only-commands  Pull only commands"
  echo "  c-bpm-cm-library-pull --only-runbooks  Pull only runbooks"
  echo "  c-bpm-cm-library-pull --version        Show version"
  echo "  c-bpm-cm-library-pull --help           Show this help"
}

# Parse arguments
for arg in "$@"; do
  case "$arg" in
    --dry-run)       DRY_RUN=1 ;;
    --verbose)       VERBOSE=1 ;;
    --force)         FORCE=1 ;;
    --clean)         CLEAN=1 ;;
    --push-inventory) PUSH_INVENTORY=1 ;;
    --only-skills)   ONLY_SKILLS=1 ;;
    --only-agents)   ONLY_AGENTS=1 ;;
    --only-commands) ONLY_COMMANDS=1 ;;
    --only-runbooks) ONLY_RUNBOOKS=1 ;;
    -v|--version)    echo "c-bpm-cm-library-pull v$VERSION"; exit 0 ;;
    -h|--help)       show_help; exit 0 ;;
    *)               echo "Unknown option: $arg"; show_help; exit 1 ;;
  esac
done

# Determine which categories to process
if [[ "$ONLY_SKILLS" -eq 1 ]] || [[ "$ONLY_AGENTS" -eq 1 ]] || [[ "$ONLY_COMMANDS" -eq 1 ]] || [[ "$ONLY_RUNBOOKS" -eq 1 ]]; then
  CATEGORIES=()
  [[ "$ONLY_SKILLS" -eq 1 ]] && CATEGORIES+=("skills")
  [[ "$ONLY_AGENTS" -eq 1 ]] && CATEGORIES+=("agents")
  [[ "$ONLY_COMMANDS" -eq 1 ]] && CATEGORIES+=("commands")
  [[ "$ONLY_RUNBOOKS" -eq 1 ]] && CATEGORIES+=("runbooks")
fi

TARGET_DIR="$(get_target_dir)"
SYNC_STATE_FILE="$TARGET_DIR/.c-bpm-library-sync"

log_verbose "Target directory: $TARGET_DIR"
log_verbose "Sync state file: $SYNC_STATE_FILE"
log_verbose "Categories: ${CATEGORIES[*]}"

load_sync_state "$SYNC_STATE_FILE"

echo "c-bpm-cm-library-pull v$VERSION"
echo ""

# Step 1: Ensure repo clone exists
if [[ ! -d "$REPO_DIR/.git" ]]; then
  echo "Repository not found at $REPO_DIR"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "Would clone: $REPO_URL -> $REPO_DIR"
    echo ""
    echo "DRY RUN - Run without --dry-run to clone and pull"
    exit 0
  fi
  echo "Cloning $REPO_URL..."
  git clone "$REPO_URL" "$REPO_DIR"
  echo ""
fi

# Step 2: Pull latest changes
cd "$REPO_DIR"
echo "Updating repository..."
if ! git pull --ff-only 2>/dev/null; then
  echo "WARNING: Fast-forward pull failed. Local changes may exist."
  echo "         Resolve manually: cd $REPO_DIR && git status"
  echo ""
fi

# Step 3: Check for my/ directory in repo
if [[ ! -d "$REPO_DIR/my" ]]; then
  echo "No my/ directory found in repository."
  echo "Nothing to pull."
  exit 0
fi

# Prune stale sync state entries (items no longer in repo)
prune_sync_state "$REPO_DIR/my"

# Host variant (#195): which next-step skill this host does not install
HOST_SKIPPED="$(host_skipped_item "$REPO_DIR")"
HOST_ADMIN_REPO="$(host_admin_repo "$REPO_DIR")"
if [[ -n "$HOST_ADMIN_REPO" ]]; then
  echo "Host variant: admin host (host repo $HOST_ADMIN_REPO), skipping $HOST_SKIPPED"
else
  log_verbose "Host variant: development host, skipping $HOST_SKIPPED"
fi

# Step 4: Compare and sync each category
NEW_COUNT=0
MODIFIED_COUNT=0
UNCHANGED_COUNT=0
CONFLICT_COUNT=0

for category in "${CATEGORIES[@]}"; do
  REPO_CAT_DIR="$REPO_DIR/my/$category"
  cat_prefix="$(get_category_prefix "$category")"

  if [[ ! -d "$REPO_CAT_DIR" ]]; then
    log_verbose "No my/$category directory in repo, skipping"
    continue
  fi

  # Determine local target based on category
  LOCAL_CAT_DIR="$TARGET_DIR/$category"
  mkdir -p "$LOCAL_CAT_DIR"

  log_verbose "Processing category: $category"
  log_verbose "  Repo:  $REPO_CAT_DIR"
  log_verbose "  Local: $LOCAL_CAT_DIR"

  # Handle skills (directories with SKILL.md)
  if [[ "$category" == "skills" ]]; then
    for item_dir in "$REPO_CAT_DIR"/"${cat_prefix}"-*/; do
      [[ -d "$item_dir" ]] || continue
      item_name=$(basename "$item_dir")
      local_item="$LOCAL_CAT_DIR/$item_name"
      item_key="$category/$item_name"

      # The other host variant: never installed here, a stale copy is removed
      if [[ "$item_key" == "$HOST_SKIPPED" ]]; then
        if [[ -d "$local_item" ]]; then
          echo "  - $item_key (other host variant, removed locally)"
          if [[ "$DRY_RUN" -eq 0 ]]; then
            rm -rf "$local_item"
            unset 'SYNC_STATE[$item_key]'
          fi
        fi
        continue
      fi

      if [[ ! -d "$local_item" ]]; then
        echo "  + $item_key (new)"
        ((NEW_COUNT++)) || true
        if [[ "$DRY_RUN" -eq 0 ]]; then
          cp -r "$item_dir" "$local_item"
          set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
        fi
      elif ! diff -rq "$item_dir" "$local_item" > /dev/null 2>&1; then
        # Items differ — check for conflict
        baseline_hash=$(get_sync_hash "$item_key")
        if [[ -n "$baseline_hash" ]]; then
          local_hash=$(compute_item_hash "$local_item")
          repo_hash=$(compute_item_hash "$item_dir")
          local_changed=0
          repo_changed=0
          [[ "$local_hash" != "$baseline_hash" ]] && local_changed=1
          [[ "$repo_hash" != "$baseline_hash" ]] && repo_changed=1

          if [[ "$local_changed" -eq 1 ]] && [[ "$repo_changed" -eq 1 ]]; then
            if [[ "$FORCE" -eq 1 ]]; then
              echo "  ~ $item_key (CONFLICT resolved: --force, repo wins)"
              ((MODIFIED_COUNT++)) || true
              if [[ "$DRY_RUN" -eq 0 ]]; then
                rm -rf "$local_item"
                cp -r "$item_dir" "$local_item"
                set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
              fi
            else
              echo "  X $item_key (CONFLICT: changed locally AND in repo)"
              ((CONFLICT_COUNT++)) || true
            fi
            continue
          fi
        fi
        # No conflict (only one side changed, or no baseline yet)
        echo "  ~ $item_key (modified)"
        ((MODIFIED_COUNT++)) || true
        if [[ "$DRY_RUN" -eq 0 ]]; then
          rm -rf "$local_item"
          cp -r "$item_dir" "$local_item"
          set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
        fi
      else
        ((UNCHANGED_COUNT++)) || true
        log_verbose "  = $item_key (unchanged)"
        # Record baseline for unchanged items if not yet tracked
        if [[ -z "$(get_sync_hash "$item_key")" ]] && [[ "$DRY_RUN" -eq 0 ]]; then
          set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
        fi
      fi
    done

    # Check for local items not in repo
    for local_item in "$LOCAL_CAT_DIR"/"${cat_prefix}"-*/; do
      [[ -d "$local_item" ]] || continue
      item_name=$(basename "$local_item")
      repo_item="$REPO_CAT_DIR/$item_name"
      if [[ ! -d "$repo_item" ]]; then
        if [[ "$CLEAN" -eq 1 ]]; then
          echo "  - $category/$item_name (removed locally)"
          [[ "$DRY_RUN" -eq 0 ]] && rm -rf "$local_item"
        else
          echo "  ! $category/$item_name (local but not in repo — use --clean to remove)"
        fi
      fi
    done
  else
    # Handle agents, commands, runbooks (flat .md files)
    for item_file in "$REPO_CAT_DIR"/"${cat_prefix}"-*.md; do
      [[ -f "$item_file" ]] || continue
      item_name=$(basename "$item_file")
      local_item="$LOCAL_CAT_DIR/$item_name"
      item_key="$category/$item_name"

      if [[ ! -f "$local_item" ]]; then
        echo "  + $item_key (new)"
        ((NEW_COUNT++)) || true
        if [[ "$DRY_RUN" -eq 0 ]]; then
          cp "$item_file" "$local_item"
          set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
        fi
      elif ! diff -q "$item_file" "$local_item" > /dev/null 2>&1; then
        # Items differ — check for conflict
        baseline_hash=$(get_sync_hash "$item_key")
        if [[ -n "$baseline_hash" ]]; then
          local_hash=$(compute_item_hash "$local_item")
          repo_hash=$(compute_item_hash "$item_file")
          local_changed=0
          repo_changed=0
          [[ "$local_hash" != "$baseline_hash" ]] && local_changed=1
          [[ "$repo_hash" != "$baseline_hash" ]] && repo_changed=1

          if [[ "$local_changed" -eq 1 ]] && [[ "$repo_changed" -eq 1 ]]; then
            if [[ "$FORCE" -eq 1 ]]; then
              echo "  ~ $item_key (CONFLICT resolved: --force, repo wins)"
              ((MODIFIED_COUNT++)) || true
              if [[ "$DRY_RUN" -eq 0 ]]; then
                cp "$item_file" "$local_item"
                set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
              fi
            else
              echo "  X $item_key (CONFLICT: changed locally AND in repo)"
              ((CONFLICT_COUNT++)) || true
            fi
            continue
          fi
        fi
        # No conflict
        echo "  ~ $item_key (modified)"
        ((MODIFIED_COUNT++)) || true
        if [[ "$DRY_RUN" -eq 0 ]]; then
          cp "$item_file" "$local_item"
          set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
        fi
      else
        ((UNCHANGED_COUNT++)) || true
        log_verbose "  = $item_key (unchanged)"
        if [[ -z "$(get_sync_hash "$item_key")" ]] && [[ "$DRY_RUN" -eq 0 ]]; then
          set_sync_hash "$item_key" "$(compute_item_hash "$local_item")"
        fi
      fi
    done

    # Check for local items not in repo
    for local_item in "$LOCAL_CAT_DIR"/"${cat_prefix}"-*.md; do
      [[ -f "$local_item" ]] || continue
      item_name=$(basename "$local_item")
      repo_item="$REPO_CAT_DIR/$item_name"
      if [[ ! -f "$repo_item" ]]; then
        if [[ "$CLEAN" -eq 1 ]]; then
          echo "  - $category/$item_name (removed locally)"
          [[ "$DRY_RUN" -eq 0 ]] && rm -rf "$local_item"
        else
          echo "  ! $category/$item_name (local but not in repo — use --clean to remove)"
        fi
      fi
    done
  fi
done

# Save sync state
save_sync_state "$SYNC_STATE_FILE"

# Hooks (agent cleanup guard) and removal of the dead skill-rules.json
install_c_bpm_hooks "$REPO_DIR" "$TARGET_DIR"
remove_legacy_skill_rules "$TARGET_DIR"

# Write host inventory
if [[ "$DRY_RUN" -eq 0 ]]; then
  write_host_inventory "$REPO_DIR" "$TARGET_DIR"
  if [[ "$PUSH_INVENTORY" -eq 1 ]]; then
    cd "$REPO_DIR"
    if ! git diff --quiet my/hosts/ 2>/dev/null; then
      git add my/hosts/
      git commit -m "Update host inventory: $(hostname)" --no-gpg-sign 2>/dev/null || true
      git push 2>/dev/null || log_verbose "Could not push host inventory (will push next time)"
    fi
  fi
fi

# Summary
echo ""
if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "DRY RUN - No changes made"
  echo "Would update: $NEW_COUNT new, $MODIFIED_COUNT modified, $UNCHANGED_COUNT unchanged"
else
  if [[ "$NEW_COUNT" -eq 0 ]] && [[ "$MODIFIED_COUNT" -eq 0 ]] && [[ "$CONFLICT_COUNT" -eq 0 ]]; then
    echo "Already up to date ($UNCHANGED_COUNT items)"
  else
    echo "Updated: $NEW_COUNT new, $MODIFIED_COUNT modified, $UNCHANGED_COUNT unchanged"
  fi
fi

if [[ "$CONFLICT_COUNT" -gt 0 ]]; then
  echo ""
  echo "CONFLICTS: $CONFLICT_COUNT item(s) changed on both sides."
  echo "  Review manually, then re-run. Or use --force to let repo win."
fi

# ── Post-pull completeness check (issue #129) ──────────────────────────────
#
# Deployment drift is silent otherwise: this script once reported "Already up
# to date" on a host where a skill existed in my/skills/ but had never landed
# in ~/.claude/skills/ — the skill was simply not installed, and nothing said so.
# After a real pull, every item in the repo MUST exist in the install target;
# if one does not, fail loudly rather than exit 0 on an incomplete install.
#
# Only the categories this run actually processed are checked, and never under
# --dry-run (where nothing was copied by design).
if [[ "$DRY_RUN" -eq 0 ]]; then
  DRIFT=()
  for category in "${CATEGORIES[@]}"; do
    REPO_CAT_DIR="$REPO_DIR/my/$category"
    [[ -d "$REPO_CAT_DIR" ]] || continue
    cat_prefix="$(get_category_prefix "$category")"

    if [[ "$category" == "skills" ]]; then
      for item_dir in "$REPO_CAT_DIR"/"${cat_prefix}"-*/; do
        [[ -d "$item_dir" ]] || continue
        item_name="$(basename "$item_dir")"
        [[ "$category/$item_name" == "$HOST_SKIPPED" ]] && continue
        [[ -d "$TARGET_DIR/$category/$item_name" ]] || DRIFT+=("$category/$item_name")
      done
    else
      for item_file in "$REPO_CAT_DIR"/"${cat_prefix}"-*.md; do
        [[ -f "$item_file" ]] || continue
        item_name="$(basename "$item_file")"
        [[ -f "$TARGET_DIR/$category/$item_name" ]] || DRIFT+=("$category/$item_name")
      done
    fi
  done

  if [[ "${#DRIFT[@]}" -gt 0 ]]; then
    echo ""
    echo "DRIFT: ${#DRIFT[@]} item(s) in the repo are MISSING from $TARGET_DIR:"
    for drift_item in "${DRIFT[@]}"; do
      echo "  ! $drift_item"
    done
    echo ""
    echo "  The pull completed but the install target is incomplete."
    echo "  Re-run c-bpm-cm-library-pull; if an item stays missing, that is a bug"
    echo "  in the pull path and not host drift — file an issue."
    exit 1
  fi
fi
